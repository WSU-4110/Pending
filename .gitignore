# ==============================================================================
# OS & General System Files
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.log
*.tmp
*.bak

# ==============================================================================
# IDEs & Editors (Android Studio, IntelliJ, VS Code)
# ==============================================================================
.idea/
*.iml
*.ipr
*.iws
.vscode/
.classpath
.project
.settings/

# Preserve IntelliJ run configurations if you intend to share them across team members
# !.idea/runConfigurations/

# ==============================================================================
# Common Gradle Caches (Both Spring Boot & Android use Gradle)
# ==============================================================================
.gradle/
build/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# Avoid checking in local Gradle / JVM performance daemons
.gradletasknamecache

# ==============================================================================
# Android App Specifics (android/)
# ==============================================================================
# Local machine SDK / NDK path
local.properties

# Android Profiler & Captures
captures/
.externalNativeBuild/
.cxx/

# Keystores & signing keys (CRITICAL: never commit credentials)
*.jks
*.keystore
release-key.properties
signing.properties

# Google Services credentials (if using Firebase/GCP)
# google-services.json

# APKs, Bundles, and ProGuard / R8 mappings
*.apk
*.aab
*.ap_
lint/
**/build/outputs/mapping/

# ==============================================================================
# Java Spring Boot Server Specifics (server/)
# ==============================================================================
# If Maven is ever used instead of Gradle
target/
**/target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
release.properties

# Compiled Java class files
*.class

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Environment files and credentials (secrets/DB passwords)
.env
.env.*
application-local.properties
application-local.yml
application-secret.properties
application-secret.yml

# Spring Boot DevTools restart trigger marker
.spring-boot-devtools.properties