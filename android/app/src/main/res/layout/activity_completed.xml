
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/pending_wave_canvas"
    android:fitsSystemWindows="true">

    <!-- Screen content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Completed"
            android:textSize="28sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/pastel_ink"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Everything you've followed through on."
            android:textSize="14sp"
            android:textColor="@color/pastel_muted"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/completedEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No completed tasks yet.\nFinished tasks will appear here."
            android:textColor="@color/pastel_muted"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="24dp"
            android:lineSpacingExtra="4dp"
            android:drawableTop="@drawable/redesign_brand_mark"
            android:drawablePadding="14dp"
            android:background="@drawable/pending_ui_white"
            android:elevation="1dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/completedRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Bottom navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:minHeight="72dp"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/bottom_nav_tint"
        app:itemTextColor="@color/bottom_nav_tint"
        app:itemActiveIndicatorStyle="@style/PendingBottomNavIndicator" />

</LinearLayout>
