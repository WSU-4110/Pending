<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_background"
    android:theme="@style/ThemeOverlay.PendingAuth">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/confirmEmailVerificationButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/verifyEmailPageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp">
                <ImageButton
                    android:id="@+id/backButtonLogin"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:background="@drawable/auth_back_background"
                    android:contentDescription="@string/verification_back"
                    app:srcCompat="@drawable/auth_ic_back"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>
                <TextView
                    android:id="@+id/LogInHeaderText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/verifyEmail"
                    android:textColor="@color/auth_ink"
                    android:textSize="20sp"
                    app:layout_constraintStart_toEndOf="@id/backButtonLogin"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="24dp"
                android:src="@drawable/verification_mail_hero"
                android:contentDescription="@string/verification_mail_description"/>
            <TextView
                android:id="@+id/checkInboxHeaderText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/CheckInbox"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/auth_ink"
                android:textSize="24sp"/>
            <TextView
                android:id="@+id/checkInboxDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/checkInboxDescrition"
                android:textColor="@color/auth_muted"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/userEmailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:text="@string/userEmail"
                android:textColor="@color/auth_deep"
                android:textSize="14sp"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/PendingAuthInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:hint="@string/verification_code_hint">
                <EditText
                    android:id="@+id/editInboxCodeNumberSigned"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:ems="10"
                    android:inputType="numberSigned"
                    android:gravity="center"
                    android:letterSpacing="0.18"
                    android:textColor="@color/auth_ink"
                    android:textSize="24sp"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/resendCodeText"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/verification_resend"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="@color/auth_deep"
                app:backgroundTint="@color/auth_white"
                app:cornerRadius="28dp"
                app:strokeColor="@color/auth_pink"
                app:strokeWidth="1dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/confirmEmailVerificationButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:text="@string/verifyEmail"
        android:textAllCaps="false"
        android:textColor="@color/auth_white"
        android:textSize="16sp"
        app:backgroundTint="@color/auth_deep"
        app:cornerRadius="32dp"
        app:layout_constraintBottom_toTopOf="@id/codeExpiresText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:id="@+id/codeExpiresText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:drawableStart="@drawable/auth_ic_shield"
        android:drawablePadding="12dp"
        android:background="@drawable/verification_info_background"
        android:gravity="center_vertical"
        android:text="@string/codeExpiration"
        android:textColor="@color/auth_muted"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
