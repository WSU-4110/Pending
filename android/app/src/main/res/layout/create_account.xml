<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_background"
    android:fitsSystemWindows="true"
    android:theme="@style/ThemeOverlay.PendingAuth"
    app:statusBarBackground="@color/auth_ink">
    <ScrollView android:id="@+id/createAccountScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            android:focusableInTouchMode="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <ImageButton
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:id="@+id/backButtonLogin"
                    android:background="@drawable/auth_back_background"
                    android:src="@drawable/auth_ic_back"
                    android:padding="13dp"
                    android:contentDescription="@string/redesign_back" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/redesign_brand_mark"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/RedesignLabel"
                        android:text="@string/redesign_brand"
                        android:layout_marginStart="9dp"
                        android:textSize="22sp"
                        android:letterSpacing="-0.03" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/RedesignTitle"
                android:text="@string/redesign_register"
                android:id="@+id/LogInHeaderText"
                android:layout_marginTop="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/RedesignBody"
                android:text="@string/redesign_register_intro"
                android:id="@+id/caAppDescription"
                android:layout_marginTop="5dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/RedesignInput"
                android:hint="@string/redesign_first"
                android:layout_marginTop="18dp"
                app:startIconDrawable="@drawable/pending_ui_ic_person">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/editTextFirstName"
                    android:inputType="textPersonName|textCapWords"
                    android:singleLine="true"
                    android:minHeight="56dp"
                    android:textColor="@color/auth_ink"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/RedesignInput"
                android:hint="@string/redesign_last"
                android:layout_marginTop="12dp"
                app:startIconDrawable="@drawable/pending_ui_ic_person">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/editTextLastName"
                    android:inputType="textPersonName|textCapWords"
                    android:singleLine="true"
                    android:minHeight="56dp"
                    android:textColor="@color/auth_ink"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/RedesignInput"
                android:hint="@string/redesign_email"
                android:layout_marginTop="12dp"
                app:startIconDrawable="@drawable/auth_ic_mail">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/editTextEmailAddress"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:minHeight="56dp"
                    android:textColor="@color/auth_ink"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/RedesignInput"
                android:hint="@string/redesign_password"
                android:layout_marginTop="12dp"
                app:startIconDrawable="@drawable/auth_ic_lock"
                app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/editTextPassword"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:minHeight="56dp"
                    android:textColor="@color/auth_ink"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/pending_ui_badge_sage"
                android:padding="12dp"
                android:layout_marginTop="8dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/RedesignLabel"
                    android:text="@string/redesign_req" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/RedesignBody"
                    android:text="@string/redesign_rules"
                    android:id="@+id/passwordCorrectnessText"
                    android:textSize="13sp"
                    android:textColor="@color/auth_ink"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/RedesignInput"
                android:hint="@string/redesign_confirm"
                android:layout_marginTop="12dp"
                app:startIconDrawable="@drawable/auth_ic_lock"
                app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/editTextConfirmPassword"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:minHeight="56dp"
                    android:textColor="@color/auth_ink"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/confirmedPassFeedbacktext"
                android:visibility="gone"
                android:textSize="13sp"
                android:textColor="@color/auth_ink" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/bottomSection"
                android:layout_marginTop="18dp">
                <com.google.android.material.button.MaterialButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/RedesignButton"
                    android:id="@+id/confirmCreateAccountButton"
                    android:text="@string/redesign_register" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/RedesignBody"
                    android:text="@string/redesign_terms"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/RedesignLink"
                    android:text="@string/redesign_registered"
                    android:id="@+id/alreadyRegisteredLink" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
