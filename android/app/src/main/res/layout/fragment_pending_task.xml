<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PendingTaskFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="107dp">

        <View
            android:id="@+id/taskColor"
            android:layout_width="8dp"
            android:layout_height="0dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@color/taskPending"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/taskName"
            android:layout_width="300dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:gravity="left|center_vertical"
            android:text="@string/taskName"
            android:textSize="20sp"
            app:layout_constraintEnd_toStartOf="@+id/viewTaskButton"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/taskColor"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/taskDescrition"
            android:layout_width="300dp"
            android:layout_height="27dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:gravity="left|center_vertical"
            android:text="@string/taskDescrition"
            app:layout_constraintEnd_toStartOf="@+id/viewTaskButton"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/taskColor"
            app:layout_constraintTop_toBottomOf="@+id/taskName" />

        <TextView
            android:id="@+id/taskDate"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="4dp"
            android:gravity="left|center_vertical"
            android:text="@string/taskDate"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/taskColor"
            app:layout_constraintTop_toBottomOf="@+id/taskDescrition"
            app:layout_constraintVertical_bias="1.0" />

        <TextView
            android:id="@+id/textView4"
            android:layout_width="124dp"
            android:layout_height="22dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:gravity="right|center_vertical"
            android:text="@string/taskReminderTime"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/taskDescrition"
            app:layout_constraintVertical_bias="1.0" />

        <Button
            android:id="@+id/viewTaskButton"
            android:layout_width="77dp"
            android:layout_height="64dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:text=">"
            android:textColorLink="@color/primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>