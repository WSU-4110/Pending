

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#D9E4DE"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="112dp"
        android:padding="14dp">

        <!-- Colored status indicator -->
        <View
            android:id="@+id/taskColor"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:background="#EF8B30"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Task title -->
        <TextView
            android:id="@+id/taskName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp"
            android:textColor="#203D35"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/taskName"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/taskColor"
            app:layout_constraintEnd_toStartOf="@id/viewTaskButton"
            tools:text="Client proposal response" />

        <!-- Short description -->
        <TextView
            android:id="@+id/taskDescrition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:textColor="#64736E"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/taskDescrition"
            app:layout_constraintTop_toBottomOf="@id/taskName"
            app:layout_constraintStart_toEndOf="@id/taskColor"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Q4 campaign scope and budget" />

        <!-- Expected response date -->
        <TextView
            android:id="@+id/taskDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="2dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="#267A67"
            android:textSize="11sp"
            android:background="#E2F3EC"
            android:text="@string/taskDate"
            app:layout_constraintTop_toBottomOf="@id/taskDescrition"
            app:layout_constraintStart_toEndOf="@id/taskColor"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="Oct 1" />

        <!-- Reminder text: hidden until linked to real data -->
        <TextView
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="#64736E"
            android:textSize="11sp"
            android:text="@string/taskReminderTime"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- View task button -->
        <Button
            android:id="@+id/viewTaskButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="›"
            android:textAllCaps="false"
            android:textColor="#64736E"
            android:textSize="24sp"
            android:backgroundTint="#FFFFFF"
            android:contentDescription="View task details"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
