<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="RedesignTitle">
        <item name="android:textColor">@color/auth_ink</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">34sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>

    <style name="RedesignBody">
        <item name="android:textColor">@color/auth_muted</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="RedesignLabel">
        <item name="android:textColor">@color/auth_ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="RedesignLink">
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/auth_deep</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="RedesignButton" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/auth_white</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="backgroundTint">@color/auth_deep</item>
    </style>

    <style name="RedesignInput" parent="PendingAuthInput">
        <item name="boxStrokeColor">@color/redesign_field_stroke</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>

    <style name="RedesignTaskField">
        <item name="android:background">@drawable/redesign_field_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/auth_ink</item>
        <item name="android:textColorHint">@color/auth_muted</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="RedesignCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">1dp</item>
        <item name="cardBackgroundColor">@color/auth_white</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/auth_soft_sage</item>
    </style>
</resources>
